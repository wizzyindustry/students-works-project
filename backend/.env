# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=db.szjkdqinobqqikhxmpnj.supabase.co
DB_PORT=5432
DB_NAME=student_materials
DB_USER=postgres
